@model TodoMVC.Models.Pelicula

@{
    ViewData["Title"] = "Nueva Película";
}

<div class="container container-sm">
    <h1>🎬 Nueva Película</h1>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-error">@ViewBag.Error</div>
    }

    <form method="post" action="/Peliculas/Crear">
        <div class="form-group">
            <label for="Titulo">Título</label>
            <input type="text" id="Titulo" name="Titulo" value="@Model?.Titulo"
                   pattern=".{3,}" title="Mínimo 3 caracteres" required autofocus />
        </div>
        <div class="form-group">
            <label for="Genero">Género</label>
            <input type="text" id="Genero" name="Genero" value="@Model?.Genero"
                   placeholder="Acción, Comedia, Drama..." required />
        </div>
        <div class="form-group">
            <label for="Anio">Año de lanzamiento</label>
            <input type="number" id="Anio" name="Anio"
                   value="@(Model != null && Model.Anio > 0 ? Model.Anio.ToString() : "2024")"
                   min="1888" max="2030" required />
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/" class="btn">Cancelar</a>
        </div>
    </form>
</div>
