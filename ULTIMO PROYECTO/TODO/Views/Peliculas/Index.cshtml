@model List<TodoMVC.Models.Pelicula>

@{
    ViewData["Title"] = "Mis Películas";
}

<div class="container">
    <div class="page-header">
        <h1>🎬 Mis Películas</h1>
        <a href="/Peliculas/Crear" class="btn btn-primary">+ Añadir película</a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <p>No hay películas todavía. ¡Añade la primera!</p>
        </div>
    }
    else
    {
        <table class="tabla-peliculas">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Género</th>
                    <th>Año</th>
                    <th>Vista</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.Vista ? "fila-vista" : "")">
                        <td>@p.Titulo</td>
                        <td><span class="badge">@p.Genero</span></td>
                        <td>@p.Anio</td>
                        <td>@(p.Vista ? "✅ Sí" : "⏳ No")</td>
                        <td class="acciones">
                            @if (!p.Vista)
                            {
                                <a href="/Peliculas/Marcar/@p.Id" class="btn btn-success btn-sm">Marcar vista</a>
                            }
                            <a href="/Peliculas/Editar/@p.Id" class="btn btn-warning btn-sm">Editar</a>
                            <a href="/Peliculas/Eliminar/@p.Id" class="btn btn-danger btn-sm"
                               onclick="return confirm('¿Eliminar esta película?')">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
